package com.example.data.database

import android.content.Context
import androidx.room.Database
import androidx.room.Room
import androidx.room.RoomDatabase
import com.example.data.dao.InstantCashDao
import com.example.data.entity.*

@Database(
    entities = [
        GigTask::class,
        UserProfile::class,
        WalletTransaction::class,
        ChatMessage::class,
        NotificationItem::class
    ],
    version = 1,
    exportSchema = false
)
abstract class InstantCashDatabase : RoomDatabase() {

    abstract fun instantCashDao(): InstantCashDao

    companion object {
        @Volatile
        private var INSTANCE: InstantCashDatabase? = null

        fun getDatabase(context: Context): InstantCashDatabase {
            return INSTANCE ?: synchronized(this) {
                val instance = Room.databaseBuilder(
                    context.applicationContext,
                    InstantCashDatabase::class.java,
                    "instant_cash_db"
                ).fallbackToDestructiveMigration().build()
                INSTANCE = instance
                instance
            }
        }
    }
}
